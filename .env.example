# Copy to .env next to docker-compose.yml — never commit .env

HOYMILES_HOST=192.168.1.50
HOYMILES_PORT=10081
HOYMILES_LISTEN=:8090
HOYMILES_DTU_SERIAL=00000000000000
HOYMILES_INV_SERIAL=00000000000000
HOYMILES_POLL=30s
HOYMILES_TIMEOUT=12s

#HOYMILES_ENCRYPTED=1
#HOYMILES_ENC_RAND=

HOYMILES_MQTT=tcp://mqtt-host:1883
#HOYMILES_MQTT_USER=
#HOYMILES_MQTT_PASS=
HOYMILES_MQTT_TOPIC=hoymiles/has
HOYMILES_MQTT_DISCOVERY=homeassistant
HOYMILES_MQTT_CLIENT_ID=hoymiles-gateway
HOYMILES_DEVICE_NAME=Hoymiles HAS
