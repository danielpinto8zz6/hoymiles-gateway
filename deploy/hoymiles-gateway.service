[Unit]
Description=Hoymiles HAS local gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hoymiles
Group=hoymiles
EnvironmentFile=/etc/hoymiles-gateway.env
ExecStart=/usr/local/bin/hoymiles-gateway \
  -host ${HOYMILES_HOST} \
  -listen ${HOYMILES_LISTEN} \
  -dtu-serial ${HOYMILES_DTU_SERIAL} \
  -inverter-serial ${HOYMILES_INV_SERIAL} \
  -poll ${HOYMILES_POLL} \
  -mqtt ${HOYMILES_MQTT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
